# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Password you type on /admin to unlock the "Connect Spotify" button
ADMIN_PASSWORD=
# Long random string used to sign the admin cookie (openssl rand -hex 32)
SESSION_SECRET=

# Optional: force the OAuth redirect URI (must match the dashboard exactly).
# Defaults to <current origin>/api/auth/callback
# SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Persistent storage (Upstash Redis via the Vercel Marketplace sets these for you;
# the KV_REST_API_* names are also supported). If unset, an in-memory store is
# used, which is only suitable for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
